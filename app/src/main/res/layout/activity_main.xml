<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/accent_blue"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/btn_overlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_start_overlay"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:backgroundTint="@color/accent_green"
        style="@style/Widget.MaterialComponents.Button" />

    <Button
        android:id="@+id/btn_auto_detect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_auto_detect_on"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:backgroundTint="@color/accent_blue"
        style="@style/Widget.MaterialComponents.Button" />

    <Button
        android:id="@+id/btn_hsv_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_hsv_settings"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:backgroundTint="@color/accent_purple"
        style="@style/Widget.MaterialComponents.Button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/instructions"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4" />

</LinearLayout>
