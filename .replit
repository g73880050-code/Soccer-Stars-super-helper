modules = ["python-3.12"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo '=== Soccer Stars Analyzer — Native Android Project ===' && echo '' && echo 'Build  : Gradle 8.4 + AGP 8.2.2' && echo 'Lang   : Kotlin 1.9.22' && echo 'MinSDK : 26 (Android 8.0)' && echo 'Target : 34 (Android 14)' && echo 'OpenCV : org.opencv:opencv:4.9.0' && echo '' && echo 'Open in Android Studio or Google IDX, then:' && echo '  ./gradlew assembleDebug' && echo ''"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "app:app"]
